FROM quay.io/fedora/fedora-bootc:45

# These arguments are explicitly supplied by build-disk.yml.
ARG TARGETARCH
ARG KOKOPLAY_IMAGE

# Validate the build arguments and select architecture-specific GRUB packages.
RUN set -eux; \
    test -n "${TARGETARCH}"; \
    test -n "${KOKOPLAY_IMAGE}"; \
    case "${TARGETARCH}" in \
        amd64) \
            GRUB_EFI_PACKAGE="grub2-efi-x64-cdboot"; \
            GRUB_PC_PACKAGE="grub2-pc-modules"; \
            ;; \
        arm64) \
            GRUB_EFI_PACKAGE="grub2-efi-aa64-cdboot"; \
            GRUB_PC_PACKAGE=""; \
            ;; \
        *) \
            echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; \
            exit 1; \
            ;; \
    esac; \
    dnf5 install -qy \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-common \
        grub2-tools \
        plymouth \
        kernel-modules \
        linux-firmware \
        NetworkManager-wifi \
        pciutils \
        usbutils \
        rfkill \
        iwlwifi-mvm-firmware \
        iwlwifi-dvm-firmware \
        iwlwifi-mld-firmware \
        iwlegacy-firmware \
        realtek-firmware \
        atheros-firmware \
        brcmfmac-firmware \
        mediatek-firmware \
        mt7xxx-firmware \
        libertas-firmware \
        atmel-firmware \
        nxpwireless-firmware \
        tiwilink-firmware \
        default-fonts-core-sans \
        default-fonts-other-sans \
        google-noto-sans-cjk-fonts \
        xorrisofs \
        squashfs-tools \
        isomd5sum \
        podman \
        jq \
        "${GRUB_EFI_PACKAGE}"; \
    if [ -n "${GRUB_PC_PACKAGE}" ]; then \
        dnf5 install -qy "${GRUB_PC_PACKAGE}"; \
    fi; \
    dnf5 clean all

# Prepare EFI boot files.
RUN mkdir -p /boot/efi && \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# ISO boot menu configuration.
RUN mkdir -p /usr/lib/image-builder/bootc

RUN printf '%s\n' \
    'label: "KokoPlay-Installer"' \
    'grub2:' \
    '  entries:' \
    '    - name: "Install KokoPlay"' \
    '      linux: "/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=KokoPlay-Installer console=tty0 inst.graphical selinux=0 rhgb quiet"' \
    '      initrd: "/images/pxeboot/initrd.img"' \
    > /usr/lib/image-builder/bootc/iso.yaml

# Configure Anaconda to install the selected KokoPlay image.
RUN printf 'bootc --source-imgref registry:%s --target-imgref %s\n' \
    "${KOKOPLAY_IMAGE}" \
    "${KOKOPLAY_IMAGE}" \
    > /usr/share/anaconda/interactive-defaults.ks

# Anaconda environment adjustments.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service \
    /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d

RUN printf '%s\n' \
    '[Login]' \
    'ReserveVT=2' \
    > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir -p /etc/NetworkManager/conf.d && \
    cat > /etc/NetworkManager/conf.d/90-disable-wifi-mac-randomization.conf <<'EOF'
[device]
wifi.scan-rand-mac-address=no

[connection]
wifi.cloned-mac-address=permanent
EOF
   
# Generate the Anaconda initramfs.
RUN set -eux; \
    mkdir -p "$(realpath /root)"; \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')"; \
    test -n "${kernel}"; \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        --add-drivers "iwlwifi iwlmvm rtl8723be rtl_pci rtlwifi rtw88_pci rtw89_pci ath9k ath10k_pci ath11k_pci mt76x2e mt7921e brcmfmac b43" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"; \
        echo "=== Verifying Wi-Fi drivers in initramfs ==="; \
        lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" \
            | grep -Ei 'iwlwifi|rtl8723be|rtw88|rtw89|ath9k|ath10k|ath11k|mt76|mt7921|brcmfmac|b43'

# Allow PipeWire services to run in the installer environment.
RUN mkdir -p /etc/systemd/user/pipewire.service.d \
             /etc/systemd/user/pipewire.socket.d

RUN printf '%s\n' \
    '[Unit]' \
    'ConditionUser=' \
    > /etc/systemd/user/pipewire.service.d/allowroot.conf

RUN printf '%s\n' \
    '[Unit]' \
    'ConditionUser=' \
    > /etc/systemd/user/pipewire.socket.d/allowroot.conf